# Django
SECRET_KEY=troque-esta-chave-em-producao
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# Produção: domínio público, ex. CSRF_TRUSTED_ORIGINS=https://sparzap.techteo.com.br
CSRF_TRUSTED_ORIGINS=

# Banco de dados (produção: PostgreSQL 16, já disponível no host da Evolution)
# Em desenvolvimento sem Postgres disponível, deixe DB_ENGINE=sqlite3 (padrão).
DB_ENGINE=sqlite3
DB_NAME=sparzap
DB_USER=sparzap
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Celery / Redis
# Em dev sem Redis disponível, deixe CELERY_TASK_ALWAYS_EAGER=True (tasks rodam de forma síncrona).
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
CELERY_TASK_ALWAYS_EAGER=True

# Evolution API
EVOLUTION_BASE_URL=http://localhost:8080
EVOLUTION_API_KEY=troque-pela-chave-real
EVOLUTION_WEBHOOK_SECRET=troque-por-um-segredo-aleatorio
# URL onde a Evolution alcança o Sparzap. NÃO use "localhost" se a Evolution
# roda em container: ali "localhost" é o próprio container, não a sua máquina,
# e os webhooks nunca chegam (status fica preso em "aguardando QR").
# Docker Desktop: http://host.docker.internal:8000 (+ ALLOWED_HOSTS)
# Produção: https://seu-dominio  ·  Dev sem Docker: ngrok ou similar
EVOLUTION_WEBHOOK_BASE_URL=http://localhost:8000

# Produção (Sprint 18): nome da rede Docker externa onde já rodam o
# Postgres/Redis/Evolution na VPS (ver docker-compose.prod.yml)
EVOLUTION_NETWORK_NAME=evolution_default

# Alertas operacionais (Sprint 19) — opcional; URL de webhook (Slack/Discord/
# genérico) que recebe um POST JSON a cada alerta. Vazio = só vai pro log.
ALERT_WEBHOOK_URL=
